<!DOCTYPE html>
<html lang="en">
<head>
    <title>Profile Page</title>
    <style>
        h1{
            color: red;
        }
    </style>
</head>
<body>
      <%- include('common/header'); %>
    <table border="1">
        <tr>
              
          <th>name</th>
          <th>email</th>
          <th>mobile</th>
          </tr>
          <%  user.forEach(function(key) { %>
            <tr> 
             
            <td> <%= key.name  %></td>
            <td> <%= key.email  %></td>
            <td> <%= key.mob  %></td>
            </tr>
            <%  }); %>
      </table>
     
</body>
</html>